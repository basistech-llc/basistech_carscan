# .envrc (Checked into Git)

export $(python3 -c "
import tomllib
with open('pyproject.toml', 'rb') as f:
    data = tomllib.load(f)
    env = data.get('tool', {}).get('env', {})
    for k, v in env.items():
        print(f'{k}={v}')
" 2>/dev/null)

# 2. Load secrets if they exist locally (Not checked into Git)
source_env_if_exists .env.local
